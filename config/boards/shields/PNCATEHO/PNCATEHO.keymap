#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

// CONFIG
#define COMBO_TIMEOUT 70
#define COMBO_LAYERS 0
#define STICKY_TIMEOUT 1000

// LAYERS
#define BASE 0
#define NAV 1
#define NUM 2

// LEFT SIDE
#define TLP 0 // TOP
#define TLR 1 // TOP
#define TLM 2 // TOP
#define TLI 3 // TOP
#define BLP 8 // BOTTOM
#define BLR 9 // BOTTOM
#define BLM 10 // BOTTOM
#define BLI 11 // BOTTOM
#define LOT 16 // O-THUMB
#define LIT 17 // I-THUMB

// RIGHT SIDE
#define TRP 4 // TOP
#define TRR 5 // TOP
#define TRM 6 // TOP
#define TRI 7 // TOP
#define BRP 12 // BOTTOM
#define BRR 13 // BOTTOM
#define BRM 14 // BOTTOM
#define BRI 15 // BOTTOM
#define ROT 18 // O-THUMB
#define RIT 19 // I-THUMB

&sk {
    release-after-ms = <STICKY_TIMEOUT>;
    quick-release;
};

// Space on tap, NAV layer on hold (inner thumb)
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
  behaviors {
    // H on tap, NUM layer on hold (bottom pinky).
    // require-prior-idle-ms: pressed right after another key = always tap, so fast typing of "h" stays safe
    num_lt: num_layer_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <200>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <150>;
      bindings = <&mo>, <&kp>;
    };
  };

  combos {
    compatible = "zmk,combos";
    #include "chords.dtsi"

    // NAV layer: ring + middle (top) = Tab
    combo_nav_tab {
      timeout-ms = <COMBO_TIMEOUT>;
      bindings = <&kp TAB>;
      key-positions = <TLR TLM>;
      layers = <NAV>;
    };

    // NUM layer
    combo_num_7 {
      timeout-ms = <COMBO_TIMEOUT>;
      bindings = <&kp N7>;
      key-positions = <TLR TLM>;
      layers = <NUM>;
    };
    combo_num_8 {
      timeout-ms = <COMBO_TIMEOUT>;
      bindings = <&kp N8>;
      key-positions = <TLM TLI>;
      layers = <NUM>;
    };
    combo_num_9 {
      timeout-ms = <COMBO_TIMEOUT>;
      bindings = <&kp N9>;
      key-positions = <BLR BLM>;
      layers = <NUM>;
    };
    combo_num_0 {
      timeout-ms = <COMBO_TIMEOUT>;
      bindings = <&kp N0>;
      key-positions = <BLM BLI>;
      layers = <NUM>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "base";
      bindings = <
        &kp B         &kp F &kp T &kp J                    &none &none &none &none
        &num_lt NUM H &kp C &kp N &kp Y                    &none &none &none &none
                                  &kp BSPC &lt NAV SPACE   &none &none
      >;
    };

    nav_layer {
      display-name = "nav";
      bindings = <
        &kp LEFT &kp UP   &kp DOWN   &kp RIGHT             &none &none &none &none
        &sk LGUI &sk LALT &sk LSHIFT &sk LCTRL             &none &none &none &none
                                     &none &trans          &none &none
      >;
    };

    num_layer {
      display-name = "num";
      bindings = <
        &kp EQUAL &kp N4 &kp N5 &kp N6                     &none &none &none &none
        &trans    &kp N1 &kp N2 &kp N3                     &none &none &none &none
                                &none &trans               &none &none
      >;
    };
  };
};
