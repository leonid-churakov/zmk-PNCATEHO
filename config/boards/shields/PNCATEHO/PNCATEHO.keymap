#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

// CONFIG
#define COMBO_TIMEOUT 70
#define COMBO_LAYERS 0
#define STICKY_TIMEOUT 500

// LAYERS
#define BASE 0
#define NAV 1

// LEFT SIDE
#define TLP 0 // TOP
#define TLR 1 // TOP
#define TLM 2 // TOP
#define TLI 3 // TOP
#define BLP 8 // BOTTOM
#define BLR 9 // BOTTOM
#define BLM 10 // BOTTOM
#define BLI 11 // BOTTOM
#define LOT 16 // O-THUMB
#define LIT 17 // I-THUMB

// RIGHT SIDE
#define TRP 4 // TOP
#define TRR 5 // TOP
#define TRM 6 // TOP
#define TRI 7 // TOP
#define BRP 12 // BOTTOM
#define BRR 13 // BOTTOM
#define BRM 14 // BOTTOM
#define BRI 15 // BOTTOM
#define ROT 18 // O-THUMB
#define RIT 19 // I-THUMB

&sk {
    release-after-ms = <STICKY_TIMEOUT>;
    quick-release;
};

// Space on tap, NAV layer on hold (inner thumb)
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
  combos {
    compatible = "zmk,combos";
    #include "chords.dtsi"

    // NAV layer: ring + middle (top) = Tab
    combo_nav_tab {
      timeout-ms = <COMBO_TIMEOUT>;
      bindings = <&kp TAB>;
      key-positions = <TLR TLM>;
      layers = <NAV>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "base";
      bindings = <
        &none &none &none &none                      &none &none &none &none
        &none &none &none &none                      &none &none &none &none
                          &none &lt NAV SPACE        &none &none
      >;
    };

    nav_layer {
      display-name = "nav";
      bindings = <
        &kp LEFT &kp UP   &kp DOWN   &kp RIGHT       &none &none &none &none
        &sk LGUI &sk LALT &sk LSHIFT &sk LCTRL       &none &none &none &none
                                     &none &trans    &none &none
      >;
    };
  };
};
